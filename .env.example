# Gemini
GEMINI_API_KEY=

# Vercel Postgres (auto-injected when you connect a Postgres DB to the project)
POSTGRES_URL=

# Resend (for email)
RESEND_API_KEY=
RESEND_FROM=Podcast Summary <onboarding@resend.dev>

# Optional: use a proxy if YouTube blocks transcript fetches from the host.
YOUTUBE_TRANSCRIPT_PROXY_URL=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
